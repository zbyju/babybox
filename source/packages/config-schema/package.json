{
  "name": "@babybox/config-schema",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "description": "The shape of configer's main.json, written once.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun --bun tsc",
    "typecheck": "bun --bun tsc -p tsconfig.tests.json",
    "test": "bun --bun vitest run --pool threads src",
    "lint": "bun --bun oxlint --type-aware --deny-warnings src",
    "format": "bun --bun oxfmt --write \"src\"",
    "format:check": "bun --bun oxfmt --check \"src\""
  },
  "license": "ISC",
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
