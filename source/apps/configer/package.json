{
  "name": "babybox-panel-configer",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "node ../startup/start-app.js configer",
    "build": "bun --bun tsc",
    "lint": "bun --bun oxlint --type-aware --deny-warnings src",
    "format": "bun --bun oxfmt --write src",
    "format:check": "bun --bun oxfmt --check src",
    "test": "bun --bun vitest run src",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babybox/config-schema": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "lodash.merge": "4.6.2",
    "lowdb": "3.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "18.11.18",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
