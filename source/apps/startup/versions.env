# Pinned toolchain for the panel computers. startup.sh reads this on every boot
# and installs these exact versions when the machine has something else.
#
# Never widen these to ranges or "latest". The boxes run unattended in
# hospitals, so a new version must only ever arrive because someone changed
# this file and shipped it.
#
# Format: bare KEY=value, one per line. No quotes, no export, no spaces around
# the "=". startup.sh sources this as bash, but startup.bat parses it by hand
# and understands nothing else.
#
# PNPM_VERSION is repeated in two files that never read this one. Move all
# three together, or the frozen install breaks on every box:
#   - source/package.json                     "packageManager": "pnpm@..."
#   - scripts/ubuntu/install-all.sh           bootstrap value for a bare machine

NODE_VERSION=18.12.1
PNPM_VERSION=7.5.0
PM2_VERSION=6.0.14
N_VERSION=10.2.0
