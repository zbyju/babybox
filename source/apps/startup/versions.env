# Pins for the panel computers.
# bootstrap.js reads this file.
# startup.sh and install-all.sh read it too.
# install-all.sh still keeps NODE_VERSION for the step before the clone.
#
# Do not use a range, a caret, a tilde, a star, or latest.
# A new version arrives only when a person changes this file and ships it.
#
# Format: bare KEY=value, one key per line.
# No quotes. No export. No spaces around "=".
# startup.sh can source this file. startup.bat parses it by hand.
# startup.bat accepts no other shape.
#
# BUN_LINUX_X64_SHA256 is the sha256 of bun-linux-x64.zip.
# BUN_WINDOWS_X64_SHA256 is the sha256 of bun-windows-x64.zip.
# Both zips are from GitHub release bun-v1.4.2.
# Do not add a baseline, musl, profile, or android zip.
#
# NODE_VERSION and PNPM_VERSION are legacy detect-only values.
# They are not upgrade targets.
# The same values also live in files that do not read this one.
# Change a value in every copy, or a frozen install fails:
#   source/package.json "packageManager"
#   source/apps/startup/scripts/ubuntu/install-all.sh
#   .github/workflows/ci.yml
#
# BUN_VERSION is also copied into .github/workflows/ci.yml.
# The Bun job installs that exact version. Change both files together.
#
# PM2_VERSION is the pin.
# startup.sh installs this exact pm2.
# The Ubuntu install script reads the same pin.
# The Windows install script still uses latest.

BUN_VERSION=1.4.2
BUN_LINUX_X64_SHA256=36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913
BUN_WINDOWS_X64_SHA256=ce4c17497b2f29712a99d3d53f028de28cd42e3bacb8589599e7f000e49b6405
PM2_VERSION=7.0.4
NODE_VERSION=18.12.1
PNPM_VERSION=7.5.0
