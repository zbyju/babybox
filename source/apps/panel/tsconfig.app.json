{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // The spec files sit next to the code they test.
  "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts"],
  // No "composite": with it, vue-tsc -p writes a .tsbuildinfo here on every box build.
  "compilerOptions": {
    // No baseUrl. TypeScript 6 deprecates it, and paths resolve from this file.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
