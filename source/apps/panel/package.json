{
  "name": "babybox-panel",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --port 5050",
    "test:unit": "vitest --environment jsdom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.vite-config.json",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier . --write",
    "echo": "echo 'Hello from panel'"
  },
  "dependencies": {
    "@babybox/config-schema": "workspace:*",
    "@vue/devtools-api": "8.2.1",
    "howler": "2.2.4",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "1.1.4",
    "@types/howler": "2.2.13",
    "@types/lodash": "4.17.25",
    "@types/node": "18.11.18",
    "@typescript-eslint/eslint-plugin": "5.31.0",
    "@typescript-eslint/parser": "5.31.0",
    "@vitejs/plugin-vue": "2.3.3",
    "@vue/eslint-config-prettier": "7.0.0",
    "@vue/eslint-config-typescript": "11.0.0",
    "@vue/reactivity": "3.5.43",
    "@vue/tsconfig": "0.9.1",
    "eslint": "8.20.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-simple-import-sort": "7.0.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "eslint-plugin-vue": "9.3.0",
    "jsdom": "16.7.0",
    "prettier": "2.7.1",
    "stylus": "0.64.0",
    "typescript": "6.0.3",
    "vite": "2.9.14",
    "vitest": "0.9.4",
    "vue-tsc": "3.3.11"
  }
}
