{
  "name": "babybox-panel",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && bun --bun vite build",
    "preview": "bun --bun vite preview --port 5050",
    "test:unit": "node ./node_modules/vitest/vitest.mjs --environment jsdom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.vite-config.json",
    "lint": "bun --bun oxlint --deny-warnings src vite.config.mts env.d.ts",
    "format": "bun --bun oxfmt --write src index.html vite.config.mts env.d.ts",
    "echo": "echo 'Hello from panel'",
    "format:check": "bun --bun oxfmt --check src index.html vite.config.mts env.d.ts"
  },
  "dependencies": {
    "@babybox/config-schema": "workspace:*",
    "@vue/devtools-api": "8.2.1",
    "howler": "2.2.4",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@types/howler": "2.2.13",
    "@types/lodash": "4.17.25",
    "@types/node": "18.11.18",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/reactivity": "3.5.43",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.1.0",
    "stylus": "0.64.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
