{
  "name": "babybox-panel-backend",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "lint": "bun --bun oxlint --type-aware --deny-warnings src",
    "format": "bun --bun oxfmt --write \"src/**/*.ts\"",
    "test": "bun --bun vitest run src",
    "typecheck": "tsc -p tsconfig.vitest.json",
    "test:postman": "newman run ./src/routes/__postman__/babybox-panel.postman_collection.json -e ./src/routes/__postman__/BabyboxPanel.postman_environment.json",
    "build": "tsc",
    "echo": "echo 'Hello from babybox panel backend'",
    "format:check": "bun --bun oxfmt --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "18.6.2",
    "newman": "6.2.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "moment": "2.31.0",
    "morgan": "1.12.1",
    "open": "11.0.4",
    "winston": "3.19.0"
  }
}
