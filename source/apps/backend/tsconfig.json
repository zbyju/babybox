{
  "extends": "../../tsconfig.contract.json",
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "./dist",
    // Node's API only: this dist also starts on the box's Node 18 when Bun is missing.
    "types": ["node"],
    // The build bundles this workspace module into dist/boundary.js.
    "paths": {
      "@babybox/config-schema": ["../../packages/config-schema/dist/index.d.ts"]
    }
  }
}
