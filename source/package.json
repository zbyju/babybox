{
  "name": "babybox-mono",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "description": "",
  "author": "",
  "keywords": [],
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run build:schema && (pnpm -F babybox-panel-configer dev & pnpm -F babybox-panel dev & pnpm -F babybox-panel-backend dev)",
    "dev:backend": "pnpm -F babybox-panel-backend dev",
    "dev:panel": "pnpm -F babybox-panel dev",
    "dev:configer": "pnpm -F babybox-panel-configer dev",
    "stop": "pm2 delete configer && pm2 delete babybox",
    "start:configer": "node apps/startup/start-app.js configer",
    "start:main": "node apps/startup/start-app.js main",
    "build:schema": "pnpm -F @babybox/config-schema build",
    "build": "node apps/startup/run-update.js",
    "echo": "echo test"
  },
  "devDependencies": {
    "@types/cors": "2.8.12",
    "@types/express": "4.17.13",
    "@types/lodash.merge": "4.6.7",
    "@types/node": "18.11.18",
    "ts-node": "10.9.1",
    "typescript": "6.0.3"
  }
}
