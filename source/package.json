{
  "name": "babybox-mono",
  "version": "1.0.0",
  "engines": {
    "node": "18.12.1",
    "bun": "1.4.2"
  },
  "description": "",
  "author": "",
  "keywords": [],
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:schema && (bun --filter babybox-panel-configer dev & bun --filter babybox-panel dev & bun --filter babybox-panel-backend dev)",
    "dev:backend": "bun --filter babybox-panel-backend dev",
    "dev:panel": "bun --filter babybox-panel dev",
    "dev:configer": "bun --filter babybox-panel-configer dev",
    "stop": "pm2 delete configer && pm2 delete babybox",
    "start:configer": "node apps/startup/start-app.js configer",
    "start:main": "node apps/startup/start-app.js main",
    "build:schema": "bun --filter @babybox/config-schema build",
    "build": "node apps/startup/run-update.js",
    "echo": "echo test"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "18.11.18",
    "typescript": "6.0.3"
  }
}
